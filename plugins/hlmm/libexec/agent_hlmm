#!/usr/bin/env python3
"""Special agent that imports HLMON service status into CheckMK.

See plans/2026-09-16-hlmm-plugin-konzept.md for the overall design
(piggyback per resolved host, displayName-based matching, HLMON API shape)
and plans/2026-09-16-hlmm-plugin-plan.md for the implementation tasks this
file is built up in.
"""

import argparse
import json
import re
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

import requests

DEBUG = False


def log_debug(msg):
    """Write a debug line to stderr, but only when --debug is active."""
    if DEBUG:
        sys.stderr.write(f"[debug] {msg}\n")


class HlmmClient:
    """Thin client for the HLMON "Monitoring Module" REST API.

    Handles HTTP Basic Auth and the pagination envelope used by /api/hosts
    and /api/services (content[] / last, see the API reference doc).
    """

    def __init__(
        self,
        base_url,
        username,
        password,
        verify_ssl=True,
        timeout=(10, 30),
        page_size=100,
    ):
        self.base_url = base_url.rstrip("/")
        self.session = requests.Session()
        self.session.auth = (username, password)
        # Also set on the session for anything that inspects it, but the
        # actual enforcement is the explicit verify=self.verify_ssl on every
        # request in get_all() below -- see the comment there for why.
        self.session.verify = verify_ssl
        self.verify_ssl = verify_ssl
        self.timeout = timeout
        self.page_size = page_size

    def get_all(self, path, filters=None, extra_params=None):
        """Fetch every page of a paginated /api/... endpoint.

        Returns (items, error). `error` is a string describing the first
        HTTP/network/decoding failure encountered; items already collected
        from earlier pages are still returned, so a late failure doesn't
        discard prior progress.
        """
        items = []
        page = 0
        while True:
            params = {"page": page, "pageSize": self.page_size}
            if extra_params:
                params.update(extra_params)
            if filters is not None:
                params["filters"] = json.dumps(filters, separators=(",", ":"))

            url = f"{self.base_url}{path}"
            start = time.monotonic()
            try:
                # verify is passed explicitly (not just via self.session.verify)
                # because requests only consults the session-level setting when
                # the per-call value is still None; if it's None, requests first
                # substitutes REQUESTS_CA_BUNDLE/CURL_CA_BUNDLE from the
                # environment (set by every OMD site) when that value isn't
                # None either, and that substituted value then wins over
                # session.verify=False in urllib3's merge logic -- silently
                # re-enabling verification. Passing verify= here keeps it a
                # concrete True/False the whole way through.
                resp = self.session.get(
                    url, params=params, timeout=self.timeout, verify=self.verify_ssl
                )
            except requests.RequestException as exc:
                log_debug(f"GET {path} page={page} -> request failed: {exc}")
                return items, f"Request failed on {path} (page {page}): {exc}"
            elapsed = time.monotonic() - start

            if resp.status_code != 200:
                log_debug(f"GET {path} page={page} -> HTTP {resp.status_code} in {elapsed:.2f}s")
                return items, f"HTTP {resp.status_code} on {path} (page {page})"

            try:
                data = resp.json()
            except ValueError as exc:
                log_debug(f"GET {path} page={page} -> invalid JSON: {exc}")
                return items, f"Invalid JSON on {path} (page {page}): {exc}"

            content = data.get("content", [])
            log_debug(f"GET {path} page={page} -> {len(content)} items in {elapsed:.2f}s")
            items.extend(content)

            if data.get("last", True) or not content:
                break
            page += 1

        return items, None


def field_in_filter(field, values):
    """Build the flat HLMON filter structure for "field in values"."""
    return [{"field": field, "comparison": "in", "value": list(values)}]


def _extract_in_filter_values(filters, field):
    """Pull the value list back out of a field_in_filter()-shaped filter.

    Only needed by ReplayClient, which has no real API to evaluate the
    filters query parameter against.
    """
    if not filters:
        return []
    for f in filters:
        if f.get("field") == field and f.get("comparison") == "in":
            return f.get("value", [])
    return []


class ReplayClient:
    """Stand-in for HlmmClient that serves local fixture files.

    Activated via --replay-dir so the agent can be developed and tested
    without access to a real HLMON server (see idea.md). The fixture
    directory holds two flat JSON arrays, `hosts.json` and `services.json`,
    each without the pagination envelope.
    """

    def __init__(self, replay_dir):
        replay_dir = Path(replay_dir)
        self._hosts = json.loads((replay_dir / "hosts.json").read_text())
        self._services = json.loads((replay_dir / "services.json").read_text())

    def get_all(self, path, filters=None, extra_params=None):
        if path == "/hosts":
            log_debug(f"replay: /hosts -> {len(self._hosts)} items")
            return self._hosts, None
        if path == "/services":
            host_ids = set(_extract_in_filter_values(filters, "hostId"))
            matched = [s for s in self._services if s.get("hostId") in host_ids]
            log_debug(f"replay: /services (hostId in {sorted(host_ids)}) -> {len(matched)} items")
            return matched, None
        return [], f"ReplayClient: unknown path {path}"


def _compile_patterns(patterns, errors):
    """Compile each pattern individually; a broken one is reported, not fatal."""
    compiled = []
    for pattern in patterns:
        try:
            compiled.append(re.compile(pattern))
        except re.error as exc:
            errors.append({"stage": "pattern", "detail": f"Invalid pattern {pattern!r}: {exc}"})
    return compiled


def _chunk(items, size):
    """Split `items` into consecutive lists of at most `size` elements."""
    items = list(items)
    for i in range(0, len(items), size):
        end = i + size
        yield items[i:end]


def _matches_any(name, compiled_patterns):
    return any(p.search(name) for p in compiled_patterns)


def parse_mappings(raw_mappings, errors):
    """Parse --mapping JSON strings into {"host_patterns", "all_hosts", "service_patterns"} dicts.

    A mapping that fails to parse as JSON is skipped (reported in `errors`),
    not fatal -- consistent with how a broken regex pattern is handled.
    """
    mappings = []
    for raw in raw_mappings:
        try:
            mapping = json.loads(raw)
        except ValueError as exc:
            errors.append({"stage": "mapping", "detail": f"Invalid --mapping JSON {raw!r}: {exc}"})
            continue
        mappings.append(
            {
                "host_patterns": mapping.get("host_patterns") or [],
                "all_hosts": bool(mapping.get("all_hosts")),
                "service_patterns": mapping.get("service_patterns") or [],
            }
        )
    return mappings


def resolve_mappings(client, mappings, errors):
    """Resolve HLMON hosts and, per host, the service patterns that apply to it.

    Each mapping pairs a set of host-name patterns (or `all_hosts`) with the
    service-name patterns that apply only to hosts it matches -- this is what
    lets one rule express independent host-pattern / service-pattern groups
    (see the ruleset's "Host / service pattern mappings" help text). A host
    matched by more than one mapping gets the union of every matching
    mapping's service patterns.

    Matching always happens against `displayName` (falling back to `name`
    only when displayName is missing/empty) — see the concept doc, section
    4, for why: `name` is HLMON's opaque internal identifier, `displayName`
    is the human-readable name that matches CheckMK hostnames.

    Returns (raw_hosts, matched, host_service_patterns):
    - `raw_hosts`: the unfiltered response from /hosts (used by --dump-dir
      so captured fixtures can later be replayed against different
      --mapping values).
    - `matched`: a deduplicated list of {"id": ..., "display_name": ...} for
      every host matched by at least one mapping.
    - `host_service_patterns`: {host_id: set_of_pattern_strings}, the union
      of service patterns from every mapping that matched that host.

    Never raises; HTTP and pattern errors are appended to `errors` and the
    function degrades to an empty/partial result instead.
    """
    hosts, error = client.get_all("/hosts")
    if error:
        errors.append({"stage": "hosts", "detail": error})

    matched_by_id = {}
    host_service_patterns = {}

    for mapping in mappings:
        if mapping["all_hosts"]:
            candidates = hosts
        else:
            compiled = _compile_patterns(mapping["host_patterns"], errors)
            if not compiled:
                continue
            candidates = [
                host
                for host in hosts
                if _matches_any(host.get("displayName") or host.get("name") or "", compiled)
            ]

        for host in candidates:
            host_id = host["id"]
            display_name = host.get("displayName") or host.get("name") or ""
            matched_by_id.setdefault(host_id, {"id": host_id, "display_name": display_name})
            host_service_patterns.setdefault(host_id, set()).update(mapping["service_patterns"])

    matched = list(matched_by_id.values())
    log_debug(
        f"resolve_mappings: {len(hosts)} hosts fetched, {len(mappings)} mappings, "
        f"{len(matched)} matched"
    )
    return hosts, matched, host_service_patterns


def fetch_services_for_hosts(client, host_ids, errors, batch_size=50):
    """Fetch all services for the given host IDs, batched via hostId "in" filters.

    A failure on one batch is recorded in `errors` (with the affected
    host_ids) but does not prevent other batches from being fetched.
    """
    services = []
    for batch in _chunk(host_ids, batch_size):
        items, error = client.get_all("/services", filters=field_in_filter("hostId", batch))
        if error:
            errors.append({"stage": "services", "detail": error, "host_ids": batch})
        services.extend(items)
    log_debug(f"fetch_services_for_hosts: {len(host_ids)} host_ids -> {len(services)} services")
    return services


def filter_services_by_host(services, host_service_patterns, errors):
    """Keep services matching the service patterns that apply to their own host.

    `host_service_patterns` maps a host id to the union of service-pattern
    strings from every mapping that matched that host (see
    resolve_mappings()) -- a service is kept only if it matches one of ITS
    host's patterns, not some global list, which is what scopes a mapping's
    service patterns to the host-pattern group they were configured under.
    """
    compiled_by_host = {}
    matched = []
    for svc in services:
        host_id = svc.get("hostId")
        patterns = host_service_patterns.get(host_id)
        if not patterns:
            continue
        if host_id not in compiled_by_host:
            compiled_by_host[host_id] = _compile_patterns(sorted(patterns), errors)
        compiled = compiled_by_host[host_id]
        if compiled and _matches_any(svc.get("displayName") or svc.get("name") or "", compiled):
            matched.append(svc)
    log_debug(f"filter_services_by_host: {len(services)} fetched, {len(matched)} matched")
    return matched


def build_service_payload(svc):
    """Reduce a raw HLMON service object to the fields the check plugin needs."""
    return {
        "id": svc["id"],
        "hostId": svc.get("hostId"),
        "displayName": svc.get("displayName") or svc.get("name"),
        "lastState": svc.get("lastState", "UNKNOWN"),
        "lastStateType": svc.get("lastStateType"),
        "lastOutput": svc.get("lastOutput", ""),
        "lastLongOutput": svc.get("lastLongOutput", ""),
        "inDowntime": bool(svc.get("inDowntime")),
        "lastProblemAcknowledged": bool(svc.get("lastProblemAcknowledged")),
        "lastAttempt": svc.get("lastAttempt"),
        "lastMaxAttempts": svc.get("lastMaxAttempts"),
        "lastEventTimestamp": svc.get("lastEventTimestamp"),
        "lastChangeTimestamp": svc.get("lastChangeTimestamp"),
        "eventSource": svc.get("eventSource"),
        "eventSourceType1": svc.get("eventSourceType1"),
        "templateIds": svc.get("templateIds") or [],
        "source": svc.get("source"),
        "customerName": svc.get("customerName"),
        "ticketCount": svc.get("ticketCount") or 0,
        "commentCount": svc.get("commentCount") or 0,
    }


def build_host_status_payload(host):
    """Reduce a raw HLMON host object to the fields the host-status check needs.

    Mirrors build_service_payload(), but for a /api/hosts entry -- hosts
    don't have hostId/eventSource*/templateIds or the service-only notice
    fields (source/customerName/ticketCount/commentCount), so those are
    intentionally left out here.
    """
    return {
        "id": host["id"],
        "displayName": host.get("displayName") or host.get("name"),
        "lastState": host.get("lastState", "UNKNOWN"),
        "lastStateType": host.get("lastStateType"),
        "lastOutput": host.get("lastOutput", ""),
        "lastLongOutput": host.get("lastLongOutput", ""),
        "inDowntime": bool(host.get("inDowntime")),
        "lastProblemAcknowledged": bool(host.get("lastProblemAcknowledged")),
        "lastAttempt": host.get("lastAttempt"),
        "lastMaxAttempts": host.get("lastMaxAttempts"),
        "lastEventTimestamp": host.get("lastEventTimestamp"),
        "lastChangeTimestamp": host.get("lastChangeTimestamp"),
    }


def build_check_config(args):
    """Settings the special-agent ruleset controls but the check function needs.

    There is deliberately no separate CheckMK check-parameter ruleset for
    hlmm_services (see the concept doc) — downtime/ack handling and
    staleness thresholds are special-agent settings, so they travel inside
    the section payload itself instead.
    """
    return {
        "service_prefix": args.service_prefix,
        "downtime_handling": args.downtime_handling,
        "ack_handling": args.ack_handling,
        "staleness_warn": args.staleness_warn,
        "staleness_crit": args.staleness_crit,
    }


def emit_piggyback(host_display_name, config, services, host_status=None):
    print(f"<<<<{host_display_name}>>>>")
    print("<<<hlmm_services:sep(0)>>>")
    print(json.dumps({"config": config, "services": services}, separators=(",", ":")))
    if host_status is not None:
        print("<<<hlmm_host_status:sep(0)>>>")
        print(json.dumps({"config": config, "host": host_status}, separators=(",", ":")))
    print("<<<<>>>>")


def emit_status(status):
    print("<<<hlmm_status:sep(0)>>>")
    print(json.dumps(status, separators=(",", ":")))


def _dump_raw(dump_dir, hosts, services):
    """Save fetched-but-unfiltered API responses for later --replay-dir use.

    `hosts` covers every host from /hosts (so a later run can experiment
    with different --mapping values); `services` covers every service
    fetched for the currently matched hosts (before per-host service-pattern
    filtering), matching what ReplayClient expects to find.
    """
    dump_dir = Path(dump_dir)
    dump_dir.mkdir(parents=True, exist_ok=True)
    (dump_dir / "hosts.json").write_text(json.dumps(hosts, indent=2))
    (dump_dir / "services.json").write_text(json.dumps(services, indent=2))


def _group_services_by_host(services, hosts_by_id):
    """Group service payloads by their host's displayName, dropping orphans.

    A service can't be grouped if its hostId isn't among the resolved hosts
    (shouldn't normally happen since services were fetched by those exact
    IDs, but a defensive check here avoids emitting piggyback data for an
    unresolved host).
    """
    grouped = {}
    for svc in services:
        host = hosts_by_id.get(svc.get("hostId"))
        if host is None:
            continue
        grouped.setdefault(host["display_name"], []).append(build_service_payload(svc))
    return grouped


def _resolve_password(args):
    """Resolve the HLMON API password: --password-ref, then --password, then stdin.

    Mirrors the proven agent_sep_sesam convention exactly (see CLAUDE.md).
    """
    if args.password_ref:
        try:
            from cmk.utils import password_store

            pw_id, pw_file = args.password_ref.split(":", maxsplit=1)
            return password_store.lookup(Path(pw_file), pw_id)
        except Exception as exc:  # noqa: BLE001 - surfaced to the user, not swallowed
            sys.exit(f"agent_hlmm: failed to resolve --password-ref: {exc}")
    if args.password:
        return args.password
    return sys.stdin.read().strip()


def _parse_args(argv):
    parser = argparse.ArgumentParser(description="HLMON special agent for CheckMK")
    parser.add_argument("--url", help="HLMON server URL, e.g. https://hlmon.example.local")
    parser.add_argument("--username", help="HLMON API username")

    pw_group = parser.add_mutually_exclusive_group()
    pw_group.add_argument(
        "--password-ref",
        help="Password store reference in the form <pw_id>:<password_store_file>. "
        "Resolved via cmk.utils.password_store.lookup at runtime so the "
        "plaintext password never appears on the command line.",
    )
    pw_group.add_argument(
        "--password",
        help="HLMON API password in plain text (not recommended -- visible in ps).",
    )

    parser.add_argument(
        "--no-verify-ssl", action="store_true", help="Disable SSL certificate verification"
    )
    parser.add_argument(
        "--mapping",
        dest="mappings",
        action="append",
        default=[],
        help="JSON object pairing host-name patterns with the service-name patterns "
        "that apply only to hosts matched by them, e.g. "
        '\'{"host_patterns": ["server-oracle"], "all_hosts": false, '
        '"service_patterns": ["orcl"]}\'. Set "all_hosts": true to match every host '
        'instead (host_patterns is then ignored). Repeatable: a host matched by more '
        "than one mapping gets the union of their service patterns.",
    )
    parser.add_argument(
        "--service-prefix",
        default="HLMM",
        help="Prepended to each imported service's displayName to form the Checkmk "
        "item (a separating space is added automatically by the check plugin, do "
        "not include a trailing space here). Pass an empty string for no prefix.",
    )
    parser.add_argument(
        "--include-host-status",
        action="store_true",
        help="Also emit a hlmm_host_status section per piggybacked host, built "
        "from the host's own raw HLMON status (not just its services).",
    )
    parser.add_argument("--downtime-handling", choices=["ok", "original"], default="ok")
    parser.add_argument("--ack-handling", choices=["ok", "original"], default="ok")
    parser.add_argument("--staleness-warn", type=int, default=None, help="Seconds")
    parser.add_argument("--staleness-crit", type=int, default=None, help="Seconds")
    parser.add_argument("--page-size", type=int, default=100)
    parser.add_argument("--host-batch-size", type=int, default=50)
    parser.add_argument("--timeout", type=float, default=30, help="HTTP read timeout in seconds")
    parser.add_argument("--debug", action="store_true", help="Verbose diagnostics on stderr")
    parser.add_argument(
        "--replay-dir",
        help="Serve hosts.json/services.json from this directory instead of querying HLMON",
    )
    parser.add_argument(
        "--dump-dir",
        help="Save raw hosts/services responses here, in --replay-dir's fixture format",
    )
    return parser.parse_args(argv)


def main(argv=None):
    global DEBUG
    args = _parse_args(argv)
    DEBUG = args.debug

    if not args.mappings:
        sys.exit("agent_hlmm: at least one --mapping is required")

    if args.replay_dir:
        client = ReplayClient(args.replay_dir)
    else:
        if not args.url or not args.username:
            sys.exit("agent_hlmm: --url and --username are required (unless --replay-dir is used)")
        password = _resolve_password(args)
        if not password:
            sys.exit("agent_hlmm: no password provided via --password-ref, --password or stdin")
        client = HlmmClient(
            args.url,
            args.username,
            password,
            verify_ssl=not args.no_verify_ssl,
            timeout=(10, args.timeout),
            page_size=args.page_size,
        )

    errors = []
    started = time.monotonic()

    mappings = parse_mappings(args.mappings, errors)

    raw_hosts, matched_hosts, host_service_patterns = resolve_mappings(client, mappings, errors)
    hosts_by_id = {h["id"]: h for h in matched_hosts}

    raw_services = fetch_services_for_hosts(
        client, list(hosts_by_id), errors, batch_size=args.host_batch_size
    )
    matched_services = filter_services_by_host(raw_services, host_service_patterns, errors)

    if args.dump_dir:
        _dump_raw(args.dump_dir, raw_hosts, raw_services)

    grouped_services = _group_services_by_host(matched_services, hosts_by_id)
    raw_hosts_by_id = {h["id"]: h for h in raw_hosts}
    config = build_check_config(args)

    # Iterate matched_hosts (not e.g. a set union) so emission order is
    # deterministic. Without --include-host-status a host is only emitted
    # if it has matched services -- same behavior as before this feature
    # existed. With it, a host with zero matched services still gets a
    # block (empty "services", populated "host"), so its own status isn't
    # silently lost just because none of its services matched the patterns.
    emitted = 0
    seen_names = set()
    for host in matched_hosts:
        display_name = host["display_name"]
        if display_name in seen_names:
            continue
        services = grouped_services.get(display_name)
        host_status = None
        if args.include_host_status:
            raw_host = raw_hosts_by_id.get(host["id"])
            if raw_host is not None:
                host_status = build_host_status_payload(raw_host)
        if services is None and host_status is None:
            continue
        emit_piggyback(display_name, config, services or [], host_status=host_status)
        seen_names.add(display_name)
        emitted += 1

    status = {
        "queried_at": datetime.now(timezone.utc).astimezone().isoformat(),
        "duration_seconds": round(time.monotonic() - started, 3),
        "hosts_total": len(raw_hosts),
        "hosts_matched": len(matched_hosts),
        "services_fetched": len(raw_services),
        "services_matched": len(matched_services),
        "targets_emitted": emitted,
        "errors": errors,
    }
    emit_status(status)


if __name__ == "__main__":
    main()
